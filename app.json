{
  "expo": {
    "name": "relatr-app",
    "slug": "relatr-app",
    "version": "1.0.0",
    "scheme": "relatr",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sarvarbek.relatr.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Ovozli xabar va audio yozish uchun mikrofonga ruxsat kerak."
      }
    },
    "android": {
      "package": "com.sarvarbek.relatr.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "READ_CONTACTS",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Ilova sizga do'stlaringizga rasm qo'shish imkonini berish uchun galereyangizga kirishi kerak."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yaqin atrofdagi do'stlarni tavsiya qilish uchun joylashuvingiz kerak."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Do'stlaringizni topish uchun kontaktlarga ruxsat kerak."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Tug'ilgan kunlarni kalendaringizga qo'shish uchun ruxsat kerak."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#8B5FE0"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-video",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "9a3d3f4b-8afb-48a8-ab1d-ab5b98413c14"
      }
    }
  }
}
